{
  "name": "Keycloak Deployment Credentials",
  "kind": "cloud",
  "inputs": {
    "fields": [
      {
        "id": "hub_kubeconfig",
        "label": "Hub kubeconfig",
        "type": "string",
        "secret": true,
        "multiline": true
      },
      {
        "id": "report_directory",
        "label": "Persistent recovery artifact directory",
        "type": "string",
        "secret": false
      }
    ],
    "required": [
      "hub_kubeconfig",
      "report_directory"
    ]
  },
  "injectors": {
    "file": {
      "template.hub_kubeconfig": "{{ hub_kubeconfig }}"
    },
    "env": {
      "KUBECONFIG": "{{ tower.filename.hub_kubeconfig }}",
      "KEYCLOAK_REPORT_DIR": "{{ report_directory }}"
    }
  }
}
