{
  "name": "Keycloak Hub Read Only",
  "kind": "cloud",
  "inputs": {
    "fields": [
      {
        "id": "hub_kubeconfig",
        "label": "Read-only hub kubeconfig",
        "type": "string",
        "secret": true,
        "multiline": true
      }
    ],
    "required": [
      "hub_kubeconfig"
    ]
  },
  "injectors": {
    "file": {
      "template": "{{ hub_kubeconfig }}"
    },
    "env": {
      "KUBECONFIG": "{{ tower.filename }}"
    }
  }
}
